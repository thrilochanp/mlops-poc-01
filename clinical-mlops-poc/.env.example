# Copy to .env and adjust as needed. All values below are the defaults
# baked into src/clinical_mlops/config.py, so .env is optional for local runs.

CLINICAL_MLOPS_DATA_DIR=data
CLINICAL_MLOPS_LOG_DIR=logs

MLFLOW_TRACKING_URI=

MODEL_NAME=clinical-doc-classifier

MODEL_STAGE=Production

EVAL_REGRESSION_TOLERANCE=0.03
